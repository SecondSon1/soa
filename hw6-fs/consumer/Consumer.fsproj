<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/Config.fs" />
    <Compile Include="src/Model.fs" />
    <Compile Include="src/Metrics.fs" />
    <Compile Include="src/Cassandra.fs" />
    <Compile Include="src/Handler.fs" />
    <Compile Include="src/Dlq.fs" />
    <Compile Include="src/Http.fs" />
    <Compile Include="src/Kafka.fs" />
    <Compile Include="src/Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.*" />
    <PackageReference Include="Confluent.SchemaRegistry" Version="2.*" />
    <PackageReference Include="Chr.Avro.Confluent" Version="10.*" />
    <PackageReference Include="CassandraCSharpDriver" Version="3.*" />
    <PackageReference Include="prometheus-net" Version="8.*" />
    <PackageReference Include="Serilog" Version="4.*" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.*" />
  </ItemGroup>
</Project>
